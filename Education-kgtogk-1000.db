      {"id": 771, "question": "Define 'KYC'.", "answer": "Know Your Customer, a mandatory verification process."},
      {"id": 772, "question": "What is 'NEFT'?", "answer": "National Electronic Funds Transfer."},
      {"id": 773, "question": "What is 'Inflation' in banking terms?", "answer": "A decrease in the purchasing power of money."},
      {"id": 774, "question": "Who acts as the regulator of capital markets in India?", "answer": "SEBI (Securities and Exchange Board of India)."},
      {"id": 775, "question": "What is a 'Cheque'?", "answer": "A document that orders a bank to pay a specific amount from an account."},
      {"id": 776, "question": "What is 'CRR'?", "answer": "Cash Reserve Ratio, the percentage of deposits kept with RBI."},
      {"id": 777, "question": "What is an 'ATM'?", "answer": "Automated Teller Machine."},
      {"id": 778, "question": "What is a 'Fixed Deposit'?", "answer": "A financial instrument where money is deposited for a fixed period."},
      {"id": 779, "question": "What is 'RTGS'?", "answer": "Real-Time Gross Settlement."},
      {"id": 780, "question": "Define 'Non-Performing Asset' (NPA).", "answer": "A loan or advance for which the principal or interest is overdue."},
      {"id": 781, "question": "What is a 'Debit Card'?", "answer": "A card that allows electronic access to the holder's bank account."},
      {"id": 782, "question": "What is 'Digital Banking'?", "answer": "The digitization of all traditional banking services."},
      {"id": 783, "question": "Who is the custodian of India's foreign exchange reserves?", "answer": "Reserve Bank of India."},
      {"id": 784, "question": "What is the 'SLR'?", "answer": "Statutory Liquidity Ratio, the minimum percentage of assets a bank must maintain."},
      {"id": 785, "question": "What is a 'Credit Card'?", "answer": "A card allowing the holder to purchase goods on credit."},
      {"id": 786, "question": "What is 'Microfinance'?", "answer": "Providing financial services to low-income individuals or groups."},
      {"id": 787, "question": "Define 'Interest Rate'.", "answer": "The proportion of a loan that is charged as interest to the borrower."},
      {"id": 788, "question": "What is an 'Overdraft'?", "answer": "A deficit in a bank account caused by drawing more money than is held."},
      {"id": 789, "question": "What is 'Financial Inclusion'?", "answer": "Ensuring affordable financial services to all sections of society."},
      {"id": 790, "question": "What is 'Bank Rate'?", "answer": "The rate at which the central bank provides loans to commercial banks."},
      {"id": 791, "question": "What is 'SWIFT'?", "answer": "Society for Worldwide Interbank Financial Telecommunication."},
      {"id": 792, "question": "What is 'Mutual Fund'?", "answer": "An investment vehicle made up of a pool of money collected from many investors."},
      {"id": 793, "question": "What is 'Net Banking'?", "answer": "Banking services performed over the internet."},
      {"id": 794, "question": "What is the 'Base Rate'?", "answer": "The minimum interest rate a bank is allowed to charge for a loan."},
      {"id": 795, "question": "What is an 'Escrow Account'?", "answer": "A temporary account held by a third party during a transaction."},
      {"id": 796, "question": "What is 'Direct Benefit Transfer' (DBT)?", "answer": "Transferring subsidies directly into the bank accounts of beneficiaries."},
      {"id": 797, "question": "What is 'Asset-Liability Management'?", "answer": "The practice of managing financial risks in a bank."},
      {"id": 798, "question": "What is 'Compound Interest'?", "answer": "Interest calculated on the initial principal and also on the accumulated interest."},
      {"id": 799, "question": "What is 'Virtual Banking'?", "answer": "Banking without any physical branches."},
      {"id": 800, "question": "What is the primary function of a Commercial Bank?", "answer": "Accepting deposits and granting loans."}
